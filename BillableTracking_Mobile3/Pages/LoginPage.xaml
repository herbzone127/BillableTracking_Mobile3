<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillableTracking_Mobile3.Pages.LoginPage"
             Title="Login">
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        <Image Source="logo.png" 
               HeightRequest="100" 
               HorizontalOptions="Center" />

        <Label Text="Welcome Back"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Sign in to continue tracking"
               FontSize="16"
               HorizontalOptions="Center" />

        <Picker Title="Select your site"
                ItemsSource="{Binding SiteOptions}"
                SelectedItem="{Binding SelectedSite}"
                
                Margin="0,10,0,0" />

        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           Color="Blue"
                           HorizontalOptions="Center" />

        <Button Text="Continue with Google"
                Command="{Binding SignInGoogleCommand}"
                
                Margin="0,10,0,0"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="Gray"
                BorderWidth="1"
                CornerRadius="5">
            <Button.ImageSource>
                <FontImageSource Glyph="G" FontFamily="YourFontFamily" Size="20" Color="Black" />
            </Button.ImageSource>
        </Button>

        <Button Text="Continue with Microsoft"
                Command="{Binding SignInMicrosoftCommand}"
                
                Margin="0,10,0,0"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="Gray"
                BorderWidth="1"
                CornerRadius="5">
            <Button.ImageSource>
                <FontImageSource Glyph="M" FontFamily="YourFontFamily" Size="20" Color="Black" />
            </Button.ImageSource>
        </Button>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           Color="Blue"
                           HorizontalOptions="Center" />

        <Label Text="{Binding StatusMessage}"
               TextColor="{Binding StatusColor}"
               FontSize="14"
               HorizontalOptions="Center" />

        <Label Text="Need help? Contact support@tracking.com"
               FontSize="12"
               HorizontalOptions="Center"
               TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>